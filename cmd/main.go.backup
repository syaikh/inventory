// Initialize scan service
scanService := newScanService(store, handler, mode)

// Start scan service
startScanService(scanner, scanService)

// Start HTTP server
if err := startHTTPServer(config.Addr, handler); err != nil {
log.Fatal("HTTP server error:", err)
}
}

